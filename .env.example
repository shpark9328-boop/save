# ─── 필수 ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ktx_alert?schema=public"
APP_BASE_URL="http://localhost:3000"

# ─── 데이터 provider ─────────────────────────────────────────────────
# mock : 개발/데모용 가상 데이터 (기본값)
# tago : 공공데이터포털(국토교통부 TAGO) 열차정보 — 시간표만 제공, 좌석 정보 없음
# http : 좌석 데이터를 제공하는 외부 어댑터 엔드포인트 (docs/providers.md 계약 참고)
TRAIN_PROVIDER="mock"

# TRAIN_PROVIDER=tago 일 때
# TAGO_SERVICE_KEY=""
# TAGO_BASE_URL="https://apis.data.go.kr/1613000/TrainInfoService"
# PROVIDER_STATION_MAP_PATH="./config/station-map.json"

# TRAIN_PROVIDER=http 일 때
# SEAT_PROVIDER_URL="https://seat-adapter.example.com/search"
# SEAT_PROVIDER_TOKEN=""

PROVIDER_TIMEOUT_MS="10000"

# ─── mock provider 튜닝 ──────────────────────────────────────────────
MOCK_AVAILABILITY_RATE="0.12"      # 좌석이 풀릴 확률 (0~1)
MOCK_FLIP_INTERVAL_SECONDS="60"    # 좌석 상태가 다시 추첨되는 주기
MOCK_LATENCY_MS="120"
MOCK_ERROR_RATE="0"

# ─── 워커 / 요청 제한 ────────────────────────────────────────────────
WORKER_TICK_SECONDS="15"                  # 워커 루프 주기
GROUP_MIN_INTERVAL_SECONDS="60"           # 같은 노선/날짜 재조회 최소 간격
PROVIDER_MIN_GAP_MS="1500"                # 외부 요청 사이 최소 간격
PROVIDER_MAX_RPM="30"                     # 분당 최대 외부 요청 수
WORKER_MAX_GROUPS_PER_TICK="10"
GROUP_FAILURE_BACKOFF_BASE_SECONDS="60"
# WORKER_ID="worker-1"                    # 비우면 자동 생성

# ─── 웹 푸시 (npm run push:keys 로 생성) ─────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ─── 이메일 알림 (선택) ──────────────────────────────────────────────
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
MAIL_FROM="KTX 좌석 알림 <no-reply@example.com>"

# ─── 관리자 ──────────────────────────────────────────────────────────
ADMIN_TOKEN=""

# ─── 기타 ────────────────────────────────────────────────────────────
RESERVATION_FALLBACK_URL="https://www.letskorail.com/"
ALERT_MAX_PER_TOKEN="10"
ALERT_MAX_DAYS_AHEAD="60"
LOG_LEVEL="info"
DRY_RUN_NOTIFICATIONS="false"
